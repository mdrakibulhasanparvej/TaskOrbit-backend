<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>Reset Your TaskFlow Password</title>
</head>

<body style=" margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background-color: #f4f7fb; padding: 40px 15px;"
    >
        <tr>
            <td align="center">

                <!-- Main Card -->
                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width: 560px;
                        background-color: #ffffff;
                        border-radius: 14px;
                        overflow: hidden;
                        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            style="
                                padding: 28px 35px;
                                background-color: #0f766e;
                                text-align: center;
                            "
                        >
                            <img
                                src="cid:brand-logo"
                                alt="TaskFlow"
                                width="48"
                                height="48"
                                style="display: block; margin: 0 auto 12px; padding: 5px; background-color: #ffffff; border-radius: 12px;"
                            />
                            <div style="
                                font-size: 26px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: -0.5px;
                            ">
                                TaskFlow
                            </div>

                            <div style="
                                margin-top: 6px;
                                font-size: 13px;
                                color: #ccfbf1;
                            ">
                                Project Management Platform
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px 35px;">

                            <h1 style="
                                margin: 0 0 15px;
                                font-size: 24px;
                                line-height: 1.3;
                                color: #111827;
                                text-align: center;
                            ">
                                Reset your password
                            </h1>

                            <p style="
                                margin: 0 0 12px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                Hello <strong style="color: #111827;"><%= name %></strong>,
                            </p>

                            <p style="
                                margin: 0 0 25px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                We received a request to reset the password for
                                <strong style="color: #111827;"><%= email %></strong>.
                                Use the code below to choose a new one:
                            </p>

                            <!-- OTP -->
                            <div style="
                                margin: 25px 0;
                                padding: 22px;
                                background-color: #f8fafc;
                                border: 1px solid #e2e8f0;
                                border-radius: 10px;
                                text-align: center;
                            ">
                                <div style="
                                    margin-bottom: 10px;
                                    font-size: 12px;
                                    font-weight: 600;
                                    letter-spacing: 1.5px;
                                    text-transform: uppercase;
                                    color: #64748b;
                                ">
                                    Reset Code
                                </div>

                                <div style="
                                    font-size: 32px;
                                    line-height: 1;
                                    font-weight: 700;
                                    letter-spacing: 8px;
                                    color: #0f766e;
                                    padding-left: 8px;
                                ">
                                    <%= otp %>
                                </div>
                            </div>

                            <!-- Expiration -->
                            <div style="
                                margin: 20px 0 25px;
                                padding: 12px 15px;
                                background-color: #fff7ed;
                                border-left: 4px solid #f97316;
                                border-radius: 5px;
                            ">
                                <p style="
                                    margin: 0;
                                    font-size: 13px;
                                    line-height: 1.6;
                                    color: #9a3412;
                                ">
                                    <strong>Important:</strong>
                                    This reset code will expire in
                                    <strong><%= expirationMinutes %> minutes</strong>.
                                </p>
                            </div>

                            <p style="
                                margin: 0;
                                font-size: 13px;
                                line-height: 1.7;
                                color: #64748b;
                            ">
                                If you did not request a password reset, you can safely
                                ignore this email — your password stays unchanged. Never
                                share this code with anyone.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="
                                padding: 22px 35px;
                                background-color: #f8fafc;
                                border-top: 1px solid #e5e7eb;
                                text-align: center;
                            "
                        >
                            <p style="
                                margin: 0 0 6px;
                                font-size: 12px;
                                color: #64748b;
                            ">
                                This is an automated email from TaskFlow.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                color: #94a3b8;
                            ">
                                © <%= new Date().getFullYear() %> TaskFlow. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
