<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>Your TaskFlow Password Was Changed</title>
</head>

<body style=" margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background-color: #f4f7fb; padding: 40px 15px;"
    >
        <tr>
            <td align="center">

                <!-- Main Card -->
                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width: 560px;
                        background-color: #ffffff;
                        border-radius: 14px;
                        overflow: hidden;
                        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            style="
                                padding: 28px 35px;
                                background-color: #0f766e;
                                text-align: center;
                            "
                        >
                            <img
                                src="cid:brand-logo"
                                alt="TaskFlow"
                                width="48"
                                height="48"
                                style="display: block; margin: 0 auto 12px; padding: 5px; background-color: #ffffff; border-radius: 12px;"
                            />
                            <div style="
                                font-size: 26px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: -0.5px;
                            ">
                                TaskFlow
                            </div>

                            <div style="
                                margin-top: 6px;
                                font-size: 13px;
                                color: #ccfbf1;
                            ">
                                Project Management Platform
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px 35px;">

                            <h1 style="
                                margin: 0 0 15px;
                                font-size: 24px;
                                line-height: 1.3;
                                color: #111827;
                                text-align: center;
                            ">
                                Password changed
                            </h1>

                            <p style="
                                margin: 0 0 12px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                Hello <strong style="color: #111827;"><%= name %></strong>,
                            </p>

                            <p style="
                                margin: 0 0 25px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                The password for your TaskFlow account was just
                                changed. All existing sessions were signed out, so
                                you will need to log in again with your new password.
                            </p>

                            <div style="
                                margin: 20px 0 25px;
                                padding: 12px 15px;
                                background-color: #fef2f2;
                                border-left: 4px solid #dc2626;
                                border-radius: 5px;
                            ">
                                <p style="
                                    margin: 0;
                                    font-size: 13px;
                                    line-height: 1.6;
                                    color: #991b1b;
                                ">
                                    <strong>Didn't do this?</strong>
                                    Reset your password again immediately or contact
                                    support — someone else may have access to your account.
                                </p>
                            </div>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="
                                padding: 22px 35px;
                                background-color: #f8fafc;
                                border-top: 1px solid #e5e7eb;
                                text-align: center;
                            "
                        >
                            <p style="
                                margin: 0 0 6px;
                                font-size: 12px;
                                color: #64748b;
                            ">
                                This is an automated email from TaskFlow.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                color: #94a3b8;
                            ">
                                © <%= new Date().getFullYear() %> TaskFlow. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
