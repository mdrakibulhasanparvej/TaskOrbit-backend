<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>You're invited to a project on TaskFlow</title>
</head>

<body style=" margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background-color: #f4f7fb; padding: 40px 15px;"
    >
        <tr>
            <td align="center">

                <!-- Main Card -->
                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width: 560px;
                        background-color: #ffffff;
                        border-radius: 14px;
                        overflow: hidden;
                        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            style="
                                padding: 28px 35px;
                                background-color: #0f766e;
                                text-align: center;
                            "
                        >
                            <img
                                src="cid:brand-logo"
                                alt="TaskFlow"
                                width="48"
                                height="48"
                                style="display: block; margin: 0 auto 12px; padding: 5px; background-color: #ffffff; border-radius: 12px;"
                            />
                            <div style="
                                font-size: 26px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: -0.5px;
                            ">
                                TaskFlow
                            </div>

                            <div style="
                                margin-top: 6px;
                                font-size: 13px;
                                color: #ccfbf1;
                            ">
                                Project Management Platform
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px 35px;">

                            <h1 style="
                                margin: 0 0 15px;
                                font-size: 24px;
                                line-height: 1.3;
                                color: #111827;
                                text-align: center;
                            ">
                                You've been invited
                            </h1>

                            <p style="
                                margin: 0 0 12px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                Hello <strong style="color: #111827;"><%= name %></strong>,
                            </p>

                            <p style="
                                margin: 0 0 25px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                <strong style="color: #111827;"><%= inviterName %></strong>
                                invited you to collaborate on the project
                                <strong style="color: #111827;"><%= projectName %></strong>.
                                Accept the invitation below to start working with the team:
                            </p>

                            <!-- Project -->
                            <div style="
                                margin-bottom: 25px;
                                padding: 16px;
                                background-color: #f0fdfa;
                                border: 1px solid #99f6e4;
                                border-radius: 10px;
                                text-align: center;
                            ">
                                <div style="
                                    font-size: 12px;
                                    font-weight: 600;
                                    letter-spacing: 1.2px;
                                    text-transform: uppercase;
                                    color: #64748b;
                                ">
                                    Project
                                </div>

                                <div style="
                                    margin-top: 6px;
                                    font-size: 17px;
                                    font-weight: 700;
                                    color: #0f766e;
                                    word-break: break-word;
                                ">
                                    <%= projectName %>
                                </div>
                            </div>

                            <!-- Accept Button -->
                            <div style="margin: 0 0 25px; text-align: center;">
                                <a
                                    href="<%= acceptUrl %>"
                                    style="
                                        display: inline-block;
                                        padding: 14px 34px;
                                        background-color: #0f766e;
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 700;
                                        text-decoration: none;
                                        border-radius: 8px;
                                    "
                                >
                                    Accept Invitation
                                </a>
                            </div>

                            <!-- Expiration -->
                            <div style="
                                margin: 0 0 25px;
                                padding: 12px 15px;
                                background-color: #fff7ed;
                                border-left: 4px solid #f97316;
                                border-radius: 5px;
                            ">
                                <p style="
                                    margin: 0;
                                    font-size: 13px;
                                    line-height: 1.6;
                                    color: #9a3412;
                                ">
                                    <strong>Important:</strong>
                                    This invitation link will expire on
                                    <strong><%= expiresOn %></strong>
                                    (in <%= expiresInDays %> days).
                                </p>
                            </div>

                            <p style="
                                margin: 0;
                                font-size: 13px;
                                line-height: 1.7;
                                color: #64748b;
                            ">
                                If you were not expecting this invitation, you can safely
                                ignore this email. The invite only works for
                                <strong><%= email %></strong>.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="
                                padding: 22px 35px;
                                background-color: #f8fafc;
                                border-top: 1px solid #e5e7eb;
                                text-align: center;
                            "
                        >
                            <p style="
                                margin: 0 0 6px;
                                font-size: 12px;
                                color: #64748b;
                            ">
                                This is an automated email from TaskFlow.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                color: #94a3b8;
                            ">
                                © <%= new Date().getFullYear() %> TaskFlow. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
