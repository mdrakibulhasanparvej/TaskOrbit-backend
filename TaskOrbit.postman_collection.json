			]
		},
		{
			"name": "Auth",
			"description": "Register → Verify Email → Login sets the `access_token` / `refresh_token` HttpOnly cookies used by every other folder.",
			"item": [
				{
					"name": "Register",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"PROJECT_MANAGER\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					},
					"description": "Public. `role` must be `PROJECT_MANAGER` or `TEAM_MEMBER` (ADMIN is not allowed here). Password: 8-24 chars, at least one uppercase + one lowercase. Responds with \"OTP has been sent to email\".",
					"response": []
				},
				{
					"name": "Verify Email",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "verify-email"]
						}
					},
					"description": "Public. `otp` must be exactly 6 digits. Success (201) sets both session cookies.",
					"response": []
				},
				{
					"name": "Resend OTP",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/resend-otp",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "resend-otp"]
						}
					},
					"response": []
				},
				{
					"name": "Login",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					},
					"description": "Public. On success (dev/test — `ENVIRONMENT !== \"production\"`) the response is `{ success: true, message: \"Login successful\", data: { user, access_token, refresh_token } }` — both tokens are returned in the body (and also set as HttpOnly cookies). The `user` object also carries `need_password_change` (true after a reset-password until `PATCH /users/me/password` clears it). The post-response script on this request fires ONLY when `success === true` and the message is the login-success one: it stores `data.access_token` / `data.refresh_token` into the collection variables (falling back to the cookies), and the collection pre-request script sends `Authorization: Bearer <access_token>` on every following request. On a failed login (`success: false`) no token is written.",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Capture tokens ONLY when the login actually succeeded.",
									"const body = pm.response.json();",
									"const succeeded = Boolean(",
									"\tbody &&",
									"\tbody.success === true &&",
									"\t/login\\s*success/i.test(String(body.message || ''))",
									");",
									"",
									"if (succeeded) {",
									"\t// primary source: the response body; fallback: the session cookie",
									"\tconst readCookie = (name) => {",
									"\t\ttry {",
									"\t\t\tconst c = pm.cookies.get(name);",
									"\t\t\tif (!c) return null;",
									"\t\t\treturn typeof c === 'object' && c.value ? c.value : c;",
									"\t\t} catch (e) { return null; }",
									"\t};",
									"",
									"\tconst data = body.data || {};",
									"\tconst access = data.access_token || readCookie('access_token');",
									"\tconst refresh = data.refresh_token || readCookie('refresh_token');",
									"",
									"\tif (access) pm.collectionVariables.set('access_token', access);",
									"\tif (refresh) pm.collectionVariables.set('refresh_token', refresh);",
									"",
									"\tpm.test('Login successful — access_token & refresh_token captured', function () {",
									"\t\tpm.expect(pm.collectionVariables.get('access_token') || '').to.not.equal('');",
									"\t\tpm.expect(pm.collectionVariables.get('refresh_token') || '').to.not.equal('');",
									"\t});",
									"} else {",
									"\tconsole.log('Login not successful — no token stored. Response:', body && body.message);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Google Login",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/google",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "google"]
						}
					},
					"description": "Public. Body: `{ \"id_token\": \"<Google ID token>\" }` — the token from a Google sign-in (gapi / GoogleIdentityServices), verified against `GOOGLE_CLIENT_ID` in `.env` (500 \"not configured\" until it is set). Signs in an existing account with the same email, links Google to a credentials account, or creates a new TEAM_MEMBER. Response mirrors Login: `{ success, message: \"Google login successful\", data: { user, access_token, refresh_token } }` in dev.",
					"response": []
				},
				{
					"name": "Forgot Password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "forgot-password"]
						}
					},
					"description": "Public. Sends a 6-digit reset OTP (5-min TTL, 1-min resend cooldown). In development the OTP is also printed to the server console as `[DEV]: Password reset otp log -> 123456`. Errors: 404 unknown email, 400 unverified account, 403 suspended or Google-only account, 429 cooldown.",
					"response": []
				},
